{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apu-ms-site",
  // Vinext builds and validates this standalone entry before deployment.
  // Do not ask Wrangler to bundle the source entry again: its virtual modules
  // exist only inside the Vinext/Vite build pipeline.
  "main": "./dist/server/index.js",
  "no_bundle": true,
  // Vinext emits a native ES-module graph, including nested SSR chunks. Discover
  // every generated JavaScript module relative to its emitted import namespace.
  "find_additional_modules": true,
  "base_dir": "./dist/server",
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  // Preserve dashboard-managed runtime variables and secrets on every code deploy.
  // Access variables are configured once in Cloudflare; credentials never belong here.
  "keep_vars": true,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Replace both provisioning placeholders with namespace IDs returned by
  // Cloudflare before deployment. Production and preview must remain isolated.
  "kv_namespaces": [
    {
      "binding": "DEV_LOG_STATE",
      "id": "DEV_LOG_STATE_PRODUCTION_NAMESPACE_ID",
      "preview_id": "DEV_LOG_STATE_PREVIEW_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
