{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apu-ms-site",
  // Vinext builds and validates this standalone entry before deployment.
  // Do not ask Wrangler to bundle the source entry again: its virtual modules
  // exist only inside the Vinext/Vite build pipeline.
  "main": "./dist/server/index.js",
  "no_bundle": true,
  // Vinext emits a native ES-module graph, including nested SSR chunks. Discover
  // every generated JavaScript module relative to its emitted import namespace.
  "find_additional_modules": true,
  "base_dir": "./dist/server",
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  // Preserve dashboard-managed runtime variables and secrets on every code deploy.
  // Access variables are configured once in Cloudflare; credentials never belong here.
  "keep_vars": true,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // Production and preview DEV LOG state must remain isolated.
  "kv_namespaces": [
    {
      "binding": "DEV_LOG_STATE",
      "id": "4a24c791d31a4c0983170c921cb744aa",
      "preview_id": "8dd4e8a10dc74086bbd746e733b3d8d8"
    }
  ],
  // Isolated, provider-free apu-pr60-e2e preparation under this parent Worker.
  // Access inputs are operator-verified; NOT READY for unauthorized deployment
  // or unverified hosted Access/KV isolation. No separate tester is approved.
  // Previews do not inherit production vars/bindings. Any later authorized
  // bootstrap must also use --ignore-base-config to exclude shared Base secrets.
  "previews": {
    "vars": {
      "APU_LOCAL_DEV_AUTH": "0",
      "CF_ACCESS_TEAM_DOMAIN": "https://catsystem-ai.cloudflareaccess.com",
      "CF_ACCESS_AUD": "1e1680481c99464a844a6ef0e502cf49fae89fc91c8cf3806ba48026b0088610",
      "APU_DEVELOPER_EMAILS": "catsystem.exe@gmail.com"
    },
    "kv_namespaces": [
      {
        "binding": "DEV_LOG_STATE",
        "id": "1729ce8a6acd4cdcbed8248ac543677b"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
