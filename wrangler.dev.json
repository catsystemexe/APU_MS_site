{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apu-ms-site-dev",
  "account_id": "4638092f63fa7fe58bcb9d2d041b7855",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "./dist/server",
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "keep_vars": false,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "DEV_LOG_STATE", "id": null }],
  "vars": {
    "APU_LOCAL_DEV_AUTH": "0",
    "APU_TELEMETRY_ENABLED": "0",
    "APU_TELEMETRY_METADATA_ENABLED": "0",
    "CF_ACCESS_TEAM_DOMAIN": null,
    "CF_ACCESS_AUD": null,
    "APU_DEVELOPER_EMAILS": null
  },
  "observability": { "enabled": false },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
